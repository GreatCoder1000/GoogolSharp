<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\lib\QuadrupleLib\QuadrupleLib\QuadrupleLib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>GoogolSharp</PackageId>
    <Version>0.2.26</Version>
    <Authors>GreatCoder1000</Authors>
    <Description>Represents numbers with reasonable precision, and googological range.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/GreatCoder1000/GoogolSharp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
