<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- GoogolSharp needs this to COMPILE -->
  <ItemGroup>
    <ProjectReference Include="..\..\external\lib\QuadrupleLib\QuadrupleLib\QuadrupleLib.csproj">
      <PrivateAssets>all</PrivateAssets>
      <Pack>false</Pack>
    </ProjectReference>
  </ItemGroup>

  <!-- Turn TargetFrameworks into an item list -->
  <ItemGroup>
    <TFM Include="$(TargetFrameworks)" />
  </ItemGroup>

  <!-- Build QuadrupleLib for each TFM -->
  <Target Name="BuildQuadrupleLib" BeforeTargets="Build;Pack">
    <MSBuild Projects="$(ProjectDir)..\..\external\lib\QuadrupleLib\QuadrupleLib\QuadrupleLib.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=%(TFM.Identity)" />
  </Target>

  <!-- Copy DLL + Add to NuGet package -->
  <Target Name="IncludeQuadrupleLib" AfterTargets="Build" DependsOnTargets="BuildQuadrupleLib">

    <ItemGroup>
      <QuadDll Include="$(ProjectDir)..\..\external\lib\QuadrupleLib\QuadrupleLib\bin\$(Configuration)\%(TFM.Identity)\QuadrupleLib.dll" />
    </ItemGroup>

    <!-- Copy to GoogolSharp output -->
    <Copy SourceFiles="@(QuadDll)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(QuadDll.Identity)')" />

    <!-- Include in NuGet package -->
    <ItemGroup>
      <None Include="@(QuadDll)"
            Pack="true"
            PackagePath="lib/%(TFM.Identity)" />
    </ItemGroup>

  </Target>

  <!-- Ensures runtime apps (like RubiksCC) get QuadrupleLib.dll -->
  <ItemGroup>
    <Reference Include="QuadrupleLib">
      <HintPath>..\..\external\lib\QuadrupleLib\QuadrupleLib\bin\$(Configuration)\$(TargetFramework)\QuadrupleLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <PackageId>GoogolSharp</PackageId>
    <Version>0.2.25</Version>
    <Authors>GreatCoder1000</Authors>
    <Description>Represents numbers with reasonable precision, and googological range.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/GreatCoder1000/GoogolSharp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
